# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGOATLAS_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ochf_database?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# OTP Verification Settings
OTP_AUTO_VERIFY=true

# Admin Seed Credentials (Optional overrides for npm run seed:admin)
ADMIN_EMAIL=admin@ochf.com
ADMIN_PASSWORD=AdminPassword123!

# Inspection Reminders Background Job
REMINDER_HOURS=24
REMINDER_CHECK_MINUTES=10
APP_TIMEZONE=Africa/Lagos

# SMTP / Mailer Configuration (Leave SMTP_HOST empty in development to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OCHF Notifications" <no-reply@ochf.com>

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
